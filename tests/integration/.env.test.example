ENVIRONMENT=test

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/<db>
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DATABASE_ADMIN_USERNAME=<admin-username>
DATABASE_ADMIN_PASSWORD=<admin-password>
DATABASE_ADMIN_EMAIL=<admin-email>
POSTGRES_USER=<pg-user>
POSTGRES_PASSWORD=<pg-password>
POSTGRES_DB=<pg-db>

# SQS / Floci
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_SQS_QUALIFY_QUEUE_NAME=<qualify-queue-name>
AWS_SQS_QUALIFY_DLQ_NAME=<qualify-dlq-name>
AWS_SQS_QUALIFY_QUEUE_URL=http://localhost:4566/000000000000/<qualify-queue-name>
AWS_SQS_QUALIFY_DLQ_URL=http://localhost:4566/000000000000/<qualify-dlq-name>
AWS_SQS_CLASSIFY_QUEUE_NAME=<classify-queue-name>
AWS_SQS_CLASSIFY_DLQ_NAME=<classify-dlq-name>
AWS_SQS_CLASSIFY_QUEUE_URL=http://localhost:4566/000000000000/<classify-queue-name>
AWS_SQS_CLASSIFY_DLQ_URL=http://localhost:4566/000000000000/<classify-dlq-name>

# Valkey
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_PASSWORD=<valkey-password>
VALKEY_DB=0

# OpenCode (mocked in integration tests)
OPENCODE_API_KEY=<opencode-api-key>
OPENCODE_API_URL=http://localhost:11434/v1
OPENCODE_DEFAULT_MODEL=<model-name>
OPENCODE_API_MODELS_URL=http://localhost:11434/v1/models

# Consumer config
CONSUMER_MAX_MESSAGES_PER_REQUEST=10
CONSUMER_MAX_POOL_TIMEOUT=20
CONSUMER_MAX_RETRIES=3
CONSUMER_MESSAGES_VISIBILITY_TIMEOUT=30

# Evaluation config
ASSESSMENT_QUALIFICATION_CHUNK_SIZE=5
ASSESSMENT_QUALIFICATION_TTL=300
ASSESSMENT_MAX_QUESTIONS_NUMBER=50
EVALUATION_MODE=normal
